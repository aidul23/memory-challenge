# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Only the ledger_llm system needs these. Fill in one provider's key.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible endpoint (Gemini, Mistral, Groq, Ollama, vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# anthropic | openai. Empty: whichever API key above is set (Anthropic first).
LLM_PROVIDER=
# Model id. Empty for Anthropic means claude-opus-5-5; required for OpenAI.
LLM_MODEL=
# Reasoning effort. Anthropic: low|medium|high|xhigh|max (empty means low).
# OpenAI: only for reasoning models; leave empty otherwise.
LLM_EFFORT=
